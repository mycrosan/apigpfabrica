{
  "info": {
    "_postman_id": "692ae178-6a82-4600-81a9-df3eaabe776c",
    "name": "Fábrica GP — PaddleOCR local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Teste direto do OCR Python local, sem a API Java. Importe o ambiente OCR local, configure o token interno e execute 01, 02 e 03. Para uma foto real, prepare o JSON com preparar_foto.py e selecione-o no Body binary da requisição 04. Consulte README.md. Não sincronize fotos, token ou respostas com serviços externos."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ocr_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 — Saúde do processo",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{ocr_base_url}}/health",
        "description": "Confirma que o processo responde. Não garante modelos carregados.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.test(\"Processo ativo\", function () { pm.expect(pm.response.json().status).to.eql(\"ativo\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Modelos prontos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{ocr_base_url}}/ready",
        "description": "Confirma carregamento dos pesos locais. HTTP 503 significa que o motor não está pronto.",
        "auth": {
          "type": "noauth"
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.test(\"Modelos carregados\", function () { const r = pm.response.json(); pm.expect(r.status).to.eql(\"pronto\"); pm.expect(r.versaoModelo).to.be.a(\"string\").and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Reconhecer DOT sintético",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ocr_base_url}}/v1/reconhecer",
        "description": "Imagem sintética de DOT 3625 já incluída. Verifica o motor; não mede precisão em pneus reais.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"campo\": \"DOT\",\n  \"foto_base64\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const resultado = pm.response.json();",
              "  pm.test(\"Motor PaddleOCR\", function () { pm.expect(resultado.motor).to.eql(\"PADDLEOCR\"); });",
              "  pm.test(\"Resposta contém linhas e duração\", function () {",
              "    pm.expect(resultado.linhas).to.be.an(\"array\");",
              "    pm.expect(resultado.duracaoMs).to.be.a(\"number\");",
              "    pm.expect(resultado.duracaoMs).to.be.at.least(0);",
              "    resultado.linhas.forEach(function (linha) {",
              "      pm.expect(linha.texto).to.be.a(\"string\");",
              "      pm.expect(linha.escore).to.be.a(\"number\");",
              "      pm.expect(linha.regiao).to.be.an(\"array\");",
              "    });",
              "  });",
              "}",
              "if (pm.response.code === 200) pm.test(\"Exemplo produziu texto\", function () { pm.expect(pm.response.json().linhas.length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Reconhecer minha foto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ocr_base_url}}/v1/reconhecer",
        "description": "Execute python3 preparar_foto.py \"/caminho/foto.jpg\" --campo DOT. Em Body > binary > Select File, selecione o JSON gerado, não o JPEG original. O arquivo contém campo e foto_base64; o Content-Type permanece application/json. Clique Send novamente para reenviar a mesma foto.",
        "body": {
          "mode": "file",
          "file": {
            "src": null
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const resultado = pm.response.json();",
              "  pm.test(\"Motor PaddleOCR\", function () { pm.expect(resultado.motor).to.eql(\"PADDLEOCR\"); });",
              "  pm.test(\"Resposta contém linhas e duração\", function () {",
              "    pm.expect(resultado.linhas).to.be.an(\"array\");",
              "    pm.expect(resultado.duracaoMs).to.be.a(\"number\");",
              "    pm.expect(resultado.duracaoMs).to.be.at.least(0);",
              "    resultado.linhas.forEach(function (linha) {",
              "      pm.expect(linha.texto).to.be.a(\"string\");",
              "      pm.expect(linha.escore).to.be.a(\"number\");",
              "      pm.expect(linha.regiao).to.be.an(\"array\");",
              "    });",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Conferir bloqueio sem token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{ocr_base_url}}/v1/reconhecer",
        "description": "Teste negativo: HTTP 403 é o resultado esperado. Nenhuma foto é enviada.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    }
  ]
}
