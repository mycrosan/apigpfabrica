<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Console Appender com formato limpo para testes -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Appender silencioso para testes -->
    <appender name="SILENT" class="ch.qos.logback.core.helpers.NOPAppender"/>

    <!-- Configurações específicas por pacote -->
    
    <!-- Silenciar completamente logs do Spring Framework -->
    <logger name="org.springframework" level="OFF" additivity="false">
        <appender-ref ref="SILENT"/>
    </logger>
    
    <!-- Silenciar logs do Hibernate -->
    <logger name="org.hibernate" level="OFF" additivity="false">
        <appender-ref ref="SILENT"/>
    </logger>
    
    <!-- Silenciar logs do H2 Database -->
    <logger name="org.h2" level="OFF" additivity="false">
        <appender-ref ref="SILENT"/>
    </logger>
    
    <!-- Silenciar logs do HikariCP -->
    <logger name="com.zaxxer.hikari" level="OFF" additivity="false">
        <appender-ref ref="SILENT"/>
    </logger>
    
    <!-- Silenciar logs do Tomcat -->
    <logger name="org.apache.catalina" level="OFF" additivity="false">
        <appender-ref ref="SILENT"/>
    </logger>
    
    <!-- Silenciar logs do Jackson -->
    <logger name="com.fasterxml.jackson" level="OFF" additivity="false">
        <appender-ref ref="SILENT"/>
    </logger>
    
    <!-- Permitir apenas logs WARN e ERROR da aplicação -->
    <logger name="br.compneusgppremium" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    
    <!-- Configuração root - apenas erros críticos -->
    <root level="ERROR">
        <appender-ref ref="CONSOLE"/>
    </root>
    
</configuration>